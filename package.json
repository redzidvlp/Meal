{
  "name": "our-table",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "description": "Shared vegetarian meal planner with pantry, live shopping list and a rule-based sous-chef.",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.3",
    "vite": "^7.3.1",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "seed:sql": "node scripts/generate-seed.mjs && node scripts/build-sql.mjs",
    "test:flows": "vite-node scripts/smoke-flows.mjs",
    "test:ui": "vite-node scripts/smoke.mjs",
    "test:connection": "vite-node scripts/smoke-connection.mjs",
    "build:sql": "node scripts/build-sql.mjs",
    "test:db": "vite-node scripts/test-db.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": "https://github.com/redzidvlp/Meal"
}
